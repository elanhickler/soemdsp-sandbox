        "text": "desc:Chaosfly v1.4\n\n/* \nwww.soundemote.com\n*/\n\nimport midi_queue.jsfx-inc\nimport ixmouse.jsfx-inc\n\nslider1:0<0,6,1{stereo chaos (pre-filter),stereo chaos,chaos A (pre-filter),chaos A,chaos B,mono mix(pre-filter),mono mix}>output\nslider2:0<-10000,10000,.001>(midi offset) Master Frequency\nslider3:0<-20000,20000,.001>Master FM \n\nslider5:.5<0,1,.0001>Lowpass Chaos\nslider6:4<0,6,1{1,2,4,8,16,32,64}>^ filter taps\nslider7:.5<0,1,.00001>Highpass Chaos\nslider8:0<0,2,1{before ocs2,after osc2,before & after osc2}>^ position\n\nslider13:0<-1000,10000,.0001>osc1 detune\nslider14:0<-1000,10000,.0001>osc2 detune\nslider15:0<-20000,20000,.001>fm1 offset\nslider16:0<-20000,20000,.001>fm2 offset\n\nslider21:0<-1,1,.001>Pan\nslider22:0.5<0,10,.01>Volume\n\nslider30:0<0,1,1{off,on}>Midi input mode\nslider31:0<0,1,1{no,yes}>Frequency returns to 0?\n \n@init\nlag_disp=.1;\nmouse.init();\nmouse.DRAG_THRESHOLD = 0;\nq.midiq_init(0, 256);\n\n/*FUNCTIONS*/\nfunction clamp(value,lo,hi) local(lo hi)(\n  value > max(lo,hi) ? hi : value < min(lo,hi) ? lo : value;\n);\nfunction in_range(value,a,b)(\n  value >= min(a,b) && value <= max(a,b) ? 1 : 0;\n);\n\nfunction in_area(value,x1,x2,y1,y2)(\n  value > min(x1,x2) && value < max(x1,x2) && value > min(y1,y2) && value < max(y1,y2) ? 1 : 0;\n);\n\n//a is taper, set a to be between -1 and +1. x is the value to be tapered, x must be between 0 and 1.\nfunction taper(a,x)local(a x)(\n  (a*x-x)/(2*a*x-a-1);\n);\n\n/*CONSTANTS*/\npi=$pi;\ntau = 2*$pi;\n\n@slider\nmix  = slider1;\ntaps = slider6;\n//coeff = exp(-tau * 10/srate);\n\n@block\nq.midiq_collect();\n\n@sample\n/*MIDI*/\nwhile(q.midiq_remove() ? ( // Remove one MIDI message from the head of the queue\n  status = q.msg1 & 0xF0;\n  velocity = q.msg23 >> 8;\n\n  // Note On\n  status == 0x90 && velocity ? (\n    note = q.msg23 & 0x7F;\n    dt = 440 * 2^((note - 69) / 12) ;\n    ) :\n    // Note Off\n    status == 0x80 || (status == 0x90 && !velocity) ? (\n    q.msg23 & 0x7F == note ? dt = slider31 ? 0 : dt;\n    );\n  1; //while( midiq_remove() ? ( dt = slider2;););\n  );\n);\n\n\n  \n/*PARAMETER SMOOTHING AND TAPER*/  \nslider30 ? (\n  !slider31 ? (\n    frequency = ((slider2 * 2^((note - 69) / 12))+dt)*tau/srate;\n  ):(\n    frequency = dt*tau/srate;\n  );\n):(\n  frequency =  slider2*tau/srate;\n);\nfm1       = slider15+slider3;\nfm2       = slider16+slider3;\nlpcut     = 1-taper(.5,slider5);\nhpcut     = -taper(-.1,slider7)+1;\nosc1f     = slider13*tau/srate;\nosc2f     = slider14*tau/srate;\nfmoff     = slider3;\nspeed     = slider16;\npan       = (slider21+1)/2;\ndt == 0 ? volume = 0 : volume = slider22;\n\ni=256; // array memory offset\n/*Parameter Smoothing*/\ni+=1; fm1       = buf[i] = (fm1 * (1-coeff)) + (buf[i] * coeff);\ni+=1; fm2       = buf[i] = (fm2 * (1-coeff)) + (buf[i] * coeff);\ni+=1; lpcut     = buf[i] = (lpcut * (1-coeff)) + (buf[i] * coeff);\ni+=1; hpcut     = buf[i] = (hpcut * (1-coeff)) + (buf[i] * coeff);\ni+=1; frequency = buf[i] = (frequency * (1-coeff)) + (buf[i] * coeff);\ni+=1; osc1f     = buf[i] = (osc1f  * (1-coeff)) + (buf[i] * coeff);\ni+=1; osc2f     = buf[i] = (osc2f  * (1-coeff)) + (buf[i] * coeff);\ni+=1; fmoff     = buf[i] = (fmoff  * (1-coeff)) + (buf[i] * coeff);\ni+=1; speed     = buf[i] = (speed  * (1-coeff)) + (buf[i] * coeff);\ni+=1; pan       = buf[i] = (pan  * (1-coeff)) + (buf[i] * coeff);\ni+=1; volume    = buf[i] = (volume  * (1-coeff)) + (buf[i] * coeff);\n\n/*HP FILTER 1*/\nslider8 == 2? (\n  otm1 = hpcut*otm1 + out1 - itm1; \n  itm1 = out1;  \n);\n\n/*OSCILLATOR 1*/\nadj1  = (tau/srate*out2*fm1)+frequency+osc1f;\npos1 += adj1;\npos1 >= tau ? pos1 -= tau;\nout1  = sin(pos1);\n\n/*HP FILTER 1*/\nslider8 == 0 || slider8 == 2 ? (\n  otm1 = hpcut*otm1 + out1 - itm1; \n  itm1 = out1;  \n  out1 = otm1;\n);\n\nprefilter = out1; /*OUTPUT TAP*/\n\n/*LP FILTER*/\ni+=1; buf[i]  = out1 * (1-lpcut) + (buf[i] * lpcut);\nloop(2^taps-1,\n  i+=1;\n  buf[i] = buf[i-1] * (1-lpcut) + (buf[i] * lpcut);\n);\nout1=buf[i];\n \n/*OSCILLATOR 2*/\nadj2  = (tau/srate*out1*fm2)+frequency+osc2f;\npos2 += adj2;\npos2 >= tau ? pos2 -= tau;\nout2  = sin(pos2+pi/2);\n\n/*HP FILTER 1*/\nslider8 == 1 || slider8 == 2 ? (\n  otm1 = hpcut*otm1 + out1 - itm1; \n  itm1 = out1;  \n  out1 = otm1;\n);\n\n/*OSCILLATOR 3*//*\nadj3  = (tau/srate)+frequency;\npos3 += adj3;\npos3 >= tau ? pos3 -= tau;\nout3  = sin(pos3);\nout2 = out2-out3;*/\n\n/*HP FILTER 2*//*\notm3 = hpcut*otm3 + out2 - itm3;\nitm3 = out2; \nout2 = otm3;*/\n\n/*OSCILLATOR 3*//*\nadj3  = (tau/srate)+frequency*2;\npos3 += adj3;\npos3 >= tau ? pos3 -= tau;\nout3  = (pos3-pi)/(pi*.5);*/\n\n/*LP FILTER*//*\nprefilter = out3;\ni+=1; buf[i]  = out3 * (1-lpcut) + (buf[i] * lpcut);\nloop(16,\n  i+=1;\n  buf[i] = buf[i-1] * (1-lpcut) + (buf[i] * lpcut);\n);\nout3=buf[i]*.5;*/\n\n\n/*MIX CONFIGURATIONS*/\nmix == 0 ? (finalout1 = prefilter; finalout2 = out2):\nmix == 1 ? (finalout1 = out1; finalout2 = out2):\nmix == 2 ? finalout1 = finalout2 = prefilter:\nmix == 3 ? finalout1 = finalout2 = out1:\nmix == 4 ? finalout1 = finalout2 = out2:\nmix == 5 ? finalout1 = finalout2 = (prefilter+out2)/2:\nmix == 6 ? finalout1 = finalout2 = (out1+out2)/2;\n/*finalout1+=out3;\nfinalout2+=out3;*/\n\n/*VOLUME & PAN*/\nfinalout1 = finalout1*volume*(1-pan);\nfinalout2 = finalout2*volume*pan;\n\n/*DC FILTERS*/\notm5      = .9999*otm5 + finalout1 - itm5; \nitm5      = finalout1; \nfinalout1 = otm5;\n\notm6      = .9999*otm6 + finalout2 - itm6;\nitm6      = finalout2;\nfinalout2 = otm6;\n\n/*SPEAKER PROTECTION*//*\nabs(finalout1) > 1 || abs(finalout2) > 1 ? ( \n  slider22*=.8;\n  speakerProtection=1;\n);\nsp+=1; sp > 5*srate ? ( speakerProtection=0; sp=0; );\nfinalout1 = abs(finalout2) > 1 ? 0 : finalout1;\nfinalout2 = abs(finalout2) > 1 ? 0 : finalout2;*/\n\n/*OUTPUT*/\nspl0 = finalout1;\nspl1 = finalout2;\n\n@gfx 100 200\nmouse.CheckState();\n\ngfx_setfont(1,\"Perfect DOS VGA 437\",17);\nfunction set_color(r,g,b,a)\n(\n  gfx_r=r;gfx_g=g;gfx_b=b;gfx_a=a;\n);\n\nset_color(.2,1,1,1);\ngfx_x=gfx_y=5;\ngfx_drawstr(\"LP = \");\nslider5 == 0 ? gfx_drawstr(\"inf\");\nslider5 > 0 && slider5 < 1 ? ( gfx_drawnumber(log(lpcut)/(-tau)*srate,0); gfx_drawstr(\" hz\"); );\nslider5 == 1 ? gfx_drawstr(\"off\");\n\ngfx_y+=15; gfx_x=5;\ngfx_drawstr(\"HP = \");\nslider7 == 0 ? gfx_drawstr(\"off\");\nslider7 > 0 && slider7 < 1 ? ( gfx_drawnumber(log(hpcut)/(-tau)*srate,0); gfx_drawstr(\" hz\"); );\nslider7 == 1 ? gfx_drawstr(\"inf\");\n\n/*LAG CONTROL*/\nin_range(mouse.lbtn.click_y,30,42) ? (\n  modifier = mouse_cap == 1 ? 100 : mouse_cap == 5 ? 10000;\n  lag_disp += mouse.lbtn.dragging ? -mouse.lbtn.delta_y/modifier;\n  lag_disp = clamp(lag_disp,0,1);\n);\ncoeff = taper(-.9995,lag_disp);\ngfx_y+=15; gfx_x=5;\ngfx_drawstr(\"Lag = \");\nlag_disp == 0 ? gfx_drawstr(\"off\");\nlag_disp > 0 && lag_disp < 1 ? ( gfx_drawnumber(lag_disp*100,2); gfx_drawstr(\"%\"); );\nlag_disp >= 1 ? (set_color(.5,.5,1,1); gfx_drawstr(\"All parameters are FROZEN! (let it go)\"); );\n\nset_color(.5,.3,.3,.7);\ngfx_y += 15; gfx_x=5;\nspeakerProtection == 1 ? set_color(1,0,0,1);\ngfx_drawstr(\"WARNING: !!!SPEAKER PROTECTED!!!\"); ",
